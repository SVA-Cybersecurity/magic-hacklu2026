# {{ ansible_managed }}
# Managed by Ansible for {{ workshop_domain }}.

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;

    # Timesketch uploads can be large.
    client_max_body_size 0;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # HTTP: ACME challenges for certbot, everything else to HTTPS.
    server {
        listen      80 default_server;
        listen [::]:80 default_server;
        server_name {{ workshop_domain }};

        location ^~ /.well-known/acme-challenge/ {
            root         /var/www/letsencrypt;
            default_type text/plain;
        }

        location / {
            return 301 https://{{ workshop_domain }}$request_uri;
        }
    }

{% if workshop_tls_enabled | bool %}
    server {
        listen      443 ssl default_server;
        listen [::]:443 ssl default_server;
        http2 on;
        server_name {{ workshop_domain }};

        ssl_certificate     /etc/letsencrypt/live/{{ workshop_domain }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ workshop_domain }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_cache   shared:SSL:10m;

        # Toggled by `make htpasswd` / `make no-htpasswd`.
        include /etc/nginx/auth.conf;

        location = /jupyter {
            return 301 /jupyter/;
        }

        location /jupyter/ {
            proxy_pass http://jupyterhub:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host       $host;
            proxy_set_header X-Real-IP  $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 86400;
        }

        location / {
            proxy_pass http://timesketch-web:5000;
            proxy_buffer_size       128k;
            proxy_buffers           4 256k;
            proxy_busy_buffers_size 256k;
            proxy_set_header Host      $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
{% endif %}
}