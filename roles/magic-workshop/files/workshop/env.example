# MAGIC workshop — environment configuration template.
# `make bootstrap` copies this to .env and fills the "generated" values with
# random secrets. Edit the rest afterwards.
#
# Named without a leading dot so it is not caught by editor/agent .env
# exclusion rules.

# ----------------------------------------------------------------------------
# Deployment
# ----------------------------------------------------------------------------
# Absolute path of this checkout on the Docker host. DockerSpawner passes bind
# mount sources straight to the host daemon, so this must be a host path.
WORKSHOP_ROOT=/opt/magic-workshop

# Public DNS name or IP of the EC2 instance. Used as the self-signed cert CN.
PUBLIC_HOSTNAME=workshop.example.com

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Docker network shared by the stack and the spawned notebook containers.
DOCKER_NETWORK_NAME=magic-workshop

# ----------------------------------------------------------------------------
# MAGIC / Microsoft 365 app registration (shared by all participants)
# ----------------------------------------------------------------------------
MAGIC_CLIENT_ID=
MAGIC_CLIENT_SECRET=
MAGIC_TENANT_ID=
# Git ref of https://github.com/SVA-Cybersecurity/magic to install.
MAGIC_REF=main

# ----------------------------------------------------------------------------
# Timesketch
# ----------------------------------------------------------------------------
TIMESKETCH_VERSION=20260630
# Git ref used to fetch the stock Timesketch config files.
TIMESKETCH_CONFIG_REF=master
TIMESKETCH_CONFIG_PATH=./config/timesketch
TIMESKETCH_UPLOAD_PATH=./upload
TIMESKETCH_LOGS_PATH=./logs

NUM_WSGI_WORKERS=4
WSGI_WORKER_CLASS=gthread
NUM_WSGI_THREADS=4
WORKER_LOG_LEVEL=info

# Optional Timesketch admin account for the operator (`make ts-admin`).
# Provisioning does not use it: each sketch is created by the participant.
TIMESKETCH_ADMIN_USER=workshop-admin
# generated
TIMESKETCH_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Datastores
# ----------------------------------------------------------------------------
OPENSEARCH_VERSION=2.19.5
OPENSEARCH_DATA_PATH=./data/opensearch
# JVM heap in GB. Rule of thumb is RAM/2, but leave room for the notebook
# containers: with 32 GB RAM and ~10 participants, 8 is a good starting point.
OPENSEARCH_MEM_USE_GB=8

POSTGRES_VERSION=13.0-alpine
POSTGRES_DATA_PATH=./data/postgresql
# generated
POSTGRES_PASSWORD=

REDIS_VERSION=7.2.11-alpine
NGINX_VERSION=1.25.5-alpine-slim

# ----------------------------------------------------------------------------
# JupyterHub
# ----------------------------------------------------------------------------
JUPYTERHUB_VERSION=5.3.0
SINGLEUSER_IMAGE=magic-workshop-singleuser:latest
SINGLEUSER_BASE_IMAGE=quay.io/jupyter/base-notebook:python-3.11
# Comma-separated JupyterHub usernames with admin rights.
JUPYTERHUB_ADMIN_USERS=workshop-admin
SINGLEUSER_MEM_LIMIT=3G
SINGLEUSER_CPU_LIMIT=1.5
PARTICIPANT_DATA_DIR=participants-data
SHARED_DATA_DIR=shared-data
