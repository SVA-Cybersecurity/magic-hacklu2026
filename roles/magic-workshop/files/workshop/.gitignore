# ---------------------------------------------------------------------------
# Secrets — must never be published
# ---------------------------------------------------------------------------
# Generated by `make bootstrap`; holds the MAGIC client secret, the Postgres
# password and the Timesketch admin password.
.env
.env.*

# Issued participant credentials.
participants.csv
participants.generated.csv
*credentials*.csv
handout/

# TLS private key / certificate and the basic-auth database.
certs/
config/nginx/htpasswd
*.key
*.pem
*.crt
*.p12

# Rendered from .env by `make bootstrap`; contains SECRET_KEY and the Postgres
# connection URI.
config/timesketch/

# Per-participant home directories: the rendered config.yaml carries the MAGIC
# client secret, the notebook carries that participant's Timesketch password.
participants-data/

# ---------------------------------------------------------------------------
# Runtime state
# ---------------------------------------------------------------------------
data/
logs/
upload/

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
# Earlier Traefik-based prototype, superseded by the nginx stack at the repo
# root. Delete this line if you do want to publish it.
tests/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
